<Window x:Class="DeskDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskDock" Width="900" Height="700" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#101720" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="24,25,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="39" Height="39" CornerRadius="12" Background="{StaticResource AccentDarkBrush}" Margin="0,0,11,0">
                        <TextBlock Text="D" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DeskDock" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="INPUT BRIDGE" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,48,0,0">
                    <TextBlock Text="CONNECTION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="1,0,0,13" />
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#E3A86B" Margin="0,0,8,0" />
                                <TextBlock x:Name="ConnectionStateText" Text="Not connected" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceResolutionText" Text="Connect an Android device by USB" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="16,7,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ANDROID DEVICE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="1,27,0,9" />
                    <ComboBox x:Name="DeviceComboBox" Height="42" DisplayMemberPath="Label" />
                    <Button x:Name="RefreshButton" Content="Refresh devices" HorizontalAlignment="Stretch" Margin="0,9,0,0"
                            Click="RefreshButton_Click" />
                    <Button x:Name="ConnectButton" Content="Connect over USB" HorizontalAlignment="Stretch" Margin="0,9,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="#10211C" BorderBrush="{StaticResource AccentBrush}"
                            Click="ConnectButton_Click" />

                    <TextBlock Text="ADB PLATFORM-TOOLS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="1,27,0,9" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AdbPathBox" Height="40" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse" Padding="11,8" Margin="7,0,0,0" Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock Text="Uses adb.exe from Android SDK Platform-Tools." FontSize="10" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="1,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="USB debugging must be enabled on Android." FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastText" Text="" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,30,28,30" MaxWidth="580" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="20" Padding="11,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="WINDOWS  →  ANDROID" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="42" FontWeight="SemiBold" LineHeight="49" Margin="0,18,0,0">
                        <Run Text="One mouse." />
                        <LineBreak />
                        <Run Text="Two screens." />
                    </TextBlock>
                    <TextBlock Text="Move across the edge of your Windows desktop and keep working on Android with the same mouse and keyboard." 
                               FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,13,18,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="19" Margin="0,28,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Mouse + keyboard sharing" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModeText" Text="Connect your Android device to begin." FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,14,0" />
                        </StackPanel>
                        <Button x:Name="ControlButton" Grid.Column="1" Content="Start sharing" Padding="16,11"
                                IsEnabled="False" Click="ControlButton_Click" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,29,0,0">
                    <TextBlock Text="How the handoff works" FontSize="17" FontWeight="SemiBold" />
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Connect" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <TextBlock Text="Plug in USB and authorize this PC." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Cross over" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <TextBlock Text="Move the pointer through the right edge." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="15" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Come back" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <TextBlock Text="Move left to return, or press Ctrl + Alt + F12." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="3" Background="#111D24" BorderBrush="#24443A" BorderThickness="1" CornerRadius="14"
                        Padding="17" Margin="0,26,0,0">
                    <StackPanel>
                        <TextBlock Text="Built for direct input" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="DeskDock sends mouse and keyboard events over the USB debugging connection. It does not extend or mirror your Windows display." 
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Text="Early build · Android behavior can vary by device and OS version." FontSize="10"
                           Foreground="{StaticResource MutedBrush}" Margin="1,17,0,0" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
